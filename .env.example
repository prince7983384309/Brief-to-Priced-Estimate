# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider to use for extraction: "openai", "anthropic", or "gemini"
LLM_PROVIDER=gemini

# Primary + fallback model names (used if the primary model/call fails)
# openai example:    MODEL_NAME=gpt-4o-mini           FALLBACK_MODEL_NAME=gpt-3.5-turbo
# anthropic example: MODEL_NAME=claude-3-5-haiku-latest FALLBACK_MODEL_NAME=claude-3-haiku-20240307
# gemini example:    MODEL_NAME=gemini-3.8-flash       FALLBACK_MODEL_NAME=gemini-flash-lite-latest
# (run `genai.list_models()` against your own key if these ever 404 -- Google
# retires/renames Gemini model ids fairly often; "-latest" aliases age better)
# Note: Gemini's free tier caps each distinct model at 20 requests/day. If
# you hit a 429 ResourceExhausted error, pick a different (unused that day)
# model name for MODEL_NAME/FALLBACK_MODEL_NAME -- each model name has its
# own separate quota bucket, so switching unblocks you immediately instead
# of waiting for the daily reset.
MODEL_NAME=gemini-3.8-flash
FALLBACK_MODEL_NAME=gemini-flash-lite-latest

# API keys (only the one matching LLM_PROVIDER is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Set to "true" to also run a vision-LLM gem-count estimate alongside the
# classical OpenCV baseline (requires an API key with vision support)
VISION_LLM_ENABLED=false

# Dev-only: allows the frontend (served from a different origin/port) to
# call this API. Set to a specific origin (e.g. http://localhost:5500)
# instead of "*" before deploying anywhere public.
CORS_ALLOWED_ORIGINS=*

# Leave INVENTORY_PATH unset to use backend/data/inventory.csv automatically
# (resolved relative to the code, not the launch directory). Only set this
# if you need to point at a different catalog file -- use an absolute path.
# INVENTORY_PATH=
